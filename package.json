{
  "name": "pi-bootstrap",
  "version": "0.7.0",
  "private": true,
  "description": "Personal Pi bootstrap with Codemode content processing and optional enterprise search.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "dotfiles",
    "bootstrap"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/process-content/index.ts"
    ],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --experimental-strip-types --test tests/*/*.test.ts && python3 scripts/verify-models.py",
    "test:pi": "python3 scripts/smoke-pi.py",
    "test:pi:live": "node --experimental-strip-types scripts/smoke-summary.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "dependencies": {
    "google-auth-library": "^10.6.2"
  }
}
