# Optional direnv configuration. Do not put credentials in this file.
# Load the parent directory's reviewed environment (if present).
source_up_if_exists

# Reuse a key already supplied by your secret loader.
if [[ -z "${LITELLM_API_KEY:-}" && -n "${LITELLM_MASTER_KEY:-}" ]]; then
  export LITELLM_API_KEY="$LITELLM_MASTER_KEY"
fi
